<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ServiceOps" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="ServiceOps">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <% if authenticated? %>
      <header class="border-b border-slate-200 bg-white shadow-sm">
        <nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-5 px-5 py-4">
          <%= link_to "ServiceOps", root_path, class: "mr-4 text-xl font-bold text-blue-700" %>
          <%= link_to "Clientes", customers_path, class: "font-medium hover:text-blue-700" %>
          <%= link_to "Categorias", service_categories_path, class: "font-medium hover:text-blue-700" %>
          <%= link_to "Ordens", service_orders_path, class: "font-medium hover:text-blue-700" %>
          <div class="ml-auto flex items-center gap-4 text-sm">
            <span class="text-slate-500"><%= Current.user.email_address %> · <%= Current.user.role %></span>
            <%= button_to "Sair", session_path, method: :delete, class: "font-medium text-red-700 hover:text-red-900" %>
          </div>
        </nav>
      </header>
    <% end %>

    <main class="mx-auto max-w-7xl px-5 py-10">
      <% if alert.present? %>
        <p class="mb-5 rounded-md bg-red-50 px-4 py-3 font-medium text-red-700"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
